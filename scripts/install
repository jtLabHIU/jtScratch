#!/usr/bin/env bash
# etrobo environment addon subcommand: jtScratch and jtS3H installer
addon_name="jtScratch"
subcommand="install"
# Copyright (c) 2026 jtLab, Hokkaido Information University
# by TANAHASHI, Jiro(aka jtFuruhata) <jt@do-johodai.ac.jp>
# Released under the MIT license
# https://opensource.org/licenses/mit-license.php
#
# Resolve the addon directory and script revision used by --version.
addon_dir="$ETROBO_ADDON/$addon_name"
ver=`git -C "$addon_dir" log -1 --date=short --format="%cd.%h" -- scripts/install`

# Show usage or version information without installing.
if [ "$1" == "--help" ] || [ "$1" == "usage" ]; then
    echo "usage: jtScratch install [--no-clone] [</absolute/path/to/jtScratchRepos>]"
    exit 0
elif [ "$1" == "--version" ] || [ "$1" == "version" ] || [ "$1" == "ver" ]; then
    echo "Ver.$ver"
    exit 0
fi

# Select whether missing repositories may be cloned.
unset no_clone
if [ "$1" == "--no-clone" ]; then
    no_clone="no-clone"
    shift
fi
if [ "$#" -gt 1 ] || { [ "$#" -gt 0 ] && [ "${1#--}" != "$1" ]; }; then
    echo "Error: Invalid install arguments. Use: jtScratch install [--no-clone] [</absolute/path/to/jtScratchRepos>]" >&2
    exit 1
fi

# Resolve and validate the repository location before changing the environment.
repos_link="$addon_dir/repos"
if [ "$#" -gt 0 ]; then
    jt_scratch_repos="$1"
elif [ -n "$no_clone" ] && [ -L "$repos_link" ]; then
    jt_scratch_repos="$(realpath -m -- "$repos_link")"
    if [ "$?" != "0" ]; then
        echo "Error: Could not resolve repository link: $repos_link" >&2
        exit 1
    fi
else
    if [ -z "$ETROBO_USERPROFILE" ]; then
        echo "Error: ETROBO_USERPROFILE is not set. Specify an absolute jtScratchRepos path." >&2
        exit 1
    fi
    jt_scratch_repos="$ETROBO_USERPROFILE/jtScratchRepos"
fi

if [ "${jt_scratch_repos#/}" == "$jt_scratch_repos" ]; then
    echo "Error: jtScratchRepos must be an absolute path: $jt_scratch_repos" >&2
    exit 1
fi
jt_scratch_repos="$(realpath -m -- "$jt_scratch_repos")"
if [ "$?" != "0" ]; then
    echo "Error: Could not resolve jtScratchRepos path." >&2
    exit 1
fi
if [ -e "$jt_scratch_repos" ] && [ ! -d "$jt_scratch_repos" ]; then
    echo "Error: jtScratchRepos is not a directory: $jt_scratch_repos" >&2
    exit 1
fi
if [ -L "$repos_link" ]; then
    existing_repos="$(realpath -m -- "$repos_link")"
    if [ "$?" != "0" ]; then
        echo "Error: Could not resolve repository link: $repos_link" >&2
        exit 1
    fi
    if [ "$existing_repos" != "$jt_scratch_repos" ]; then
        echo "Error: $repos_link already points to a different directory." >&2
        exit 1
    fi
elif [ -e "$repos_link" ]; then
    echo "Error: $repos_link already exists and is not a symbolic link. Move it before installing." >&2
    exit 1
fi

# Wine needs its 32-bit runtime to run Windows installer tools during cross-builds.
if [ "$(dpkg --print-foreign-architectures | grep -Fx "i386")" == "" ]; then
    echo "Enabling the i386 architecture for Windows Electron build tools ..."
    sudo dpkg --add-architecture i386
    if [ "$?" != "0" ]; then
        echo "Error: Could not enable the i386 architecture required by Wine." >&2
        exit 1
    fi
fi

# install required packages if not already installed
echo "Updating APT package lists and installing tools needed to build the repositories ..."
sudo apt update
if [ "$?" != "0" ]; then
    echo "Error: Could not update the APT package lists." >&2
    exit 1
fi
sudo apt install -y git curl build-essential python3
if [ "$?" != "0" ]; then
    echo "Error: Could not install the required packages (git, curl, build-essential, python3)." >&2
    exit 1
fi

# install nvm if it is not already available
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
    if [ "$?" != "0" ]; then
        echo "Error: Could not load nvm from $NVM_DIR/nvm.sh." >&2
        exit 1
    fi
fi

if [ "$(command -v nvm)" == "" ]; then
    nvm_install_script="$(mktemp)"
    if [ "$?" != "0" ]; then
        echo "Error: Could not create a temporary file for the nvm installer." >&2
        exit 1
    fi

    echo "Downloading the nvm installer to manage the required Node.js version ..."
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh" -o "$nvm_install_script"
    if [ "$?" != "0" ]; then
        rm -f "$nvm_install_script"
        echo "Error: Could not download the nvm installer." >&2
        exit 1
    fi

    PROFILE=/dev/null NVM_DIR="$NVM_DIR" bash "$nvm_install_script"
    if [ "$?" != "0" ]; then
        rm -f "$nvm_install_script"
        echo "Error: Could not install nvm." >&2
        exit 1
    fi
    rm -f "$nvm_install_script"

    if [ -s "$NVM_DIR/nvm.sh" ]; then
        . "$NVM_DIR/nvm.sh"
        if [ "$?" != "0" ]; then
            echo "Error: Could not load nvm from $NVM_DIR/nvm.sh." >&2
            exit 1
        fi
    fi
fi

if [ "$(command -v nvm)" == "" ]; then
    echo "Error: nvm is not available after installation." >&2
    exit 1
fi

# Prepare the repository directory only when cloning is permitted.
if [ -z "$no_clone" ]; then
    mkdir -p "$jt_scratch_repos"
    if [ "$?" != "0" ]; then
        echo "Error: Could not create jtScratchRepos directory: $jt_scratch_repos" >&2
        exit 1
    fi
fi

# create symbolic link for repos
echo "Note: the filesystem containing $repos_link must support symbolic links (e.g. NTFS)."
if [ -L "$repos_link" ]; then
    echo "Using existing repository link: $repos_link"
elif [ -e "$repos_link" ]; then
    echo "Error: $repos_link already exists and is not a symbolic link. Move it before installing." >&2
    exit 1
elif [ -n "$no_clone" ]; then
    echo "The repository link will be created after the existing repositories are prepared."
else
    ln -s "$jt_scratch_repos" "$repos_link"
    if [ "$?" != "0" ]; then
        echo "Error: Could not create symbolic link at $repos_link. Use a filesystem that supports symbolic links." >&2
        exit 1
    fi
fi

# prepare the logs directory
logs_dir="$addon_dir/logs"
mkdir -p "$logs_dir"
if [ "$?" != "0" ]; then
    echo "Error: Could not create log directory: $logs_dir" >&2
    exit 1
fi

# function to install a repository
set -o pipefail
unset incomplete
unset node_ready
install_repository() {
    local name="$1"
    local url="$2"
    local repo_dir="$jt_scratch_repos/$name"
    local log_file="$logs_dir/install_$name.log"
    local inside_work_tree

    # create or clear the log file and check for write permission
    if [ "$name" == "scratch-desktop" ]; then
        : >> "$log_file"
    else
        : > "$log_file"
    fi
    if [ "$?" != "0" ]; then
        echo "Error: Could not write log file: $log_file" >&2
        exit 1
    fi

    # clone the repository if it doesn't exist, or use the existing one
    echo "Installing $name ..." | tee -a "$log_file"
    if [ -e "$repo_dir" ]; then
        if [ ! -d "$repo_dir" ] || { [ ! -d "$repo_dir/.git" ] && [ ! -f "$repo_dir/.git" ]; }; then
            echo "Error: $repo_dir already exists and is not a Git repository. See $log_file" >&2
            exit 1
        fi
        inside_work_tree="$(git -C "$repo_dir" rev-parse --is-inside-work-tree 2>/dev/null)"
        if [ "$?" != "0" ] || [ "$inside_work_tree" != "true" ]; then
            echo "Error: $repo_dir already exists and is not a valid Git repository. See $log_file" >&2
            exit 1
        fi
        echo "Using existing repository: $repo_dir" | tee -a "$log_file"
    elif [ -n "$no_clone" ]; then
        echo "Skipping missing repository: $repo_dir" | tee -a "$log_file"
        incomplete="incomplete"
        return
    else
        git clone "$url" "$repo_dir" 2>&1 | tee -a "$log_file"
        if [ "$?" != "0" ]; then
            echo "Error: Could not clone $name. See $log_file" >&2
            exit 1
        fi
    fi

    # Install and activate the editor's required Node.js version.
    if [ "$name" == "scratch-editor" ]; then
        if [ ! -f "$repo_dir/.nvmrc" ]; then
            if [ -n "$no_clone" ]; then
                echo "Node.js version file not found: $repo_dir/.nvmrc. Restore it before retrying." >&2
                incomplete="incomplete"
                return
            fi
            echo "Error: Node.js version file not found: $repo_dir/.nvmrc. See $log_file" >&2
            exit 1
        fi

        node_version="$(cat "$repo_dir/.nvmrc")"
        if [ "$?" != "0" ]; then
            echo "Error: Could not read a Node.js version from $repo_dir/.nvmrc. See $log_file" >&2
            exit 1
        fi
        if [ "$node_version" == "" ]; then
            if [ -n "$no_clone" ]; then
                echo "Node.js version file is empty: $repo_dir/.nvmrc. Restore it before retrying." >&2
                incomplete="incomplete"
                return
            fi
            echo "Error: Node.js version file is empty: $repo_dir/.nvmrc. See $log_file" >&2
            exit 1
        fi

        echo "Installing Node.js version $node_version from .nvmrc ..." | tee -a "$log_file"
        nvm install "$node_version" 2>&1 | tee -a "$log_file"
        if [ "$?" != "0" ]; then
            echo "Error: Could not install Node.js $node_version. See $log_file" >&2
            exit 1
        fi

        nvm use "$node_version" > >(tee -a "$log_file") 2>&1
        if [ "$?" != "0" ]; then
            echo "Error: Could not activate Node.js $node_version. See $log_file" >&2
            exit 1
        fi
        node_ready="ready"
    fi

    # Do not install dependencies using an unknown Node.js version.
    if [ -z "$node_ready" ]; then
        echo "Skipping $name npm dependencies because the Node.js version is unavailable." | tee -a "$log_file"
        return
    fi

    # install npm dependencies
    echo "Installing npm dependencies for $name ..." | tee -a "$log_file"
    bash -c 'cd "$1" && npm install' jtScratch-install "$repo_dir" 2>&1 | tee -a "$log_file"
    if [ "$?" != "0" ]; then
        echo "Error: Could not install $name dependencies. See $log_file" >&2
        exit 1
    fi
}

echo "Repositories will be stored in: $jt_scratch_repos"
echo "Logs will be stored in: $logs_dir"

# Install desktop build tools even when repositories are not yet available.
desktop_log="$logs_dir/install_scratch-desktop.log"
: > "$desktop_log"
if [ "$?" != "0" ]; then
    echo "Error: Could not write log file: $desktop_log" >&2
    exit 1
fi
echo "Installing packages required for Windows Electron builds (wine64, wine32:i386, mono-devel, libnss3) ..." | tee -a "$desktop_log"
sudo apt install -y wine64 wine32:i386 mono-devel libnss3 2>&1 | tee -a "$desktop_log"
if [ "$?" != "0" ]; then
    echo "Error: Could not install scratch-desktop Windows build packages. See $desktop_log" >&2
    exit 1
fi

# Install the repositories in the specified order.
install_repository "scratch-editor" "https://github.com/jtLabHIU/scratch-editor.git"
install_repository "scratch-desktop" "https://github.com/jtLabHIU/scratch-desktop.git"
install_repository "s3h" "https://github.com/jtLabHIU/s3h.git"

# Set up Windows Node.js after the Linux installation.
if [ "$ETROBO_OS" == "win" ] && [ -n "$node_ready" ]; then
    node_version="$(cat "$jt_scratch_repos/scratch-editor/.nvmrc")"
    if [ "$?" != "0" ] || [ "$node_version" == "" ]; then
        echo "Error: Could not read the Windows Node.js version from $jt_scratch_repos/scratch-editor/.nvmrc" >&2
        exit 1
    fi

    if [ "$(command -v powershell.exe)" == "" ] || [ "$(command -v wslpath)" == "" ]; then
        echo "Error: powershell.exe and wslpath are required to install Windows Node.js." >&2
        exit 1
    fi

    powershell_script="$addon_dir/scripts/setup-windows-node.ps1"
    if [ ! -f "$powershell_script" ]; then
        echo "Error: Windows Node.js setup script not found: $powershell_script" >&2
        exit 1
    fi
    powershell_script_windows="$(wslpath -w "$powershell_script")"
    if [ "$?" != "0" ] || [ "$powershell_script_windows" == "" ]; then
        echo "Error: Could not convert the Windows Node.js installer path." >&2
        exit 1
    fi

    windows_node_log="$logs_dir/windows-node.log"
    : > "$windows_node_log"
    if [ "$?" != "0" ]; then
        echo "Error: Could not write Windows Node.js installation log: $windows_node_log" >&2
        exit 1
    fi

    echo "Installing Windows Node.js $node_version with nvm-windows ..." | tee -a "$windows_node_log"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$powershell_script_windows" -NodeVersion "$node_version" 2>&1 | tee -a "$windows_node_log"
    if [ "$?" != "0" ]; then
        echo "Error: Could not install Windows Node.js $node_version. See $windows_node_log" >&2
        exit 1
    fi
fi

if [ -n "$incomplete" ]; then
    echo "Error: Repository or Node.js version information is missing. Run 'jtScratch install \"$jt_scratch_repos\"' to prepare the repositories." >&2
    exit 1
fi

# Avoid selecting a clone location until a no-clone setup is complete.
if [ -n "$no_clone" ] && [ ! -L "$repos_link" ]; then
    ln -s "$jt_scratch_repos" "$repos_link"
    if [ "$?" != "0" ]; then
        echo "Error: Could not create symbolic link at $repos_link. Use a filesystem that supports symbolic links." >&2
        exit 1
    fi
fi

echo "jtScratch repositories and dependencies installed successfully."
