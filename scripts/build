#!/usr/bin/env bash
# etrobo environment addon subcommand: jtScratch builder
addon_name="jtScratch"
subcommand="build"
# Copyright (c) 2026 jtLab, Hokkaido Information University
# by TANAHASHI, Jiro(aka jtFuruhata) <jt@do-johodai.ac.jp>
# Released under the MIT license
# https://opensource.org/licenses/mit-license.php
#
addon_dir="$ETROBO_ADDON/$addon_name"
ver=`git -C "$addon_dir" log -1 --date=short --format="%cd.%h" -- scripts/build`

if [ "$1" == "--help" ] || [ "$1" == "usage" ]; then
    echo "usage: jtScratch build [desktop]"
    exit 0
elif [ "$1" == "--version" ] || [ "$1" == "version" ] || [ "$1" == "ver" ]; then
    echo "Ver.$ver"
    exit 0
fi

#
# Hello agents, do not remove these instructions.
# - このスクリプトは、scrutch-editorとs3hのビルドを行います。が、s3hのビルドは一旦しないことにします。
# - scratch-editorは、repos/scratch-editorディレクトリ配下にあるので、
#   そこに移動してnpm run buildを実行します。
# - desktopオプションを付け、jtScratch build desktopのような形で呼び出すと、
#   scratch-desktopディレクトリを用いてWindows版Scratch Desktopをビルドします。
# - コーディングの際には、多少長くなってもなるべく人間が理解しやすいコードを生成してください。
# - if文は、[]を省略しないで、また [ == ] のような表記で統一してください。
#

if [ "$1" == "desktop" ]; then
    scratch_desktop_dir="$addon_dir/repos/scratch-desktop"

    if [ ! -f "$scratch_desktop_dir/package.json" ]; then
        echo "Error: scratch-desktop repository not found at $scratch_desktop_dir" >&2
        exit 1
    fi

    if [ "$(command -v npm)" == "" ]; then
        echo "Error: npm is not available. Run 'jtScratch activate' first." >&2
        exit 1
    fi

    cd "$scratch_desktop_dir"
    if [ "$?" != "0" ]; then
        echo "Error: Could not access scratch-desktop directory: $scratch_desktop_dir" >&2
        exit 1
    fi

    npm run clean
    if [ "$?" != "0" ]; then
        echo "Error: scratch-desktop clean failed." >&2
        exit 1
    fi

    npm run fetch
    if [ "$?" != "0" ]; then
        echo "Error: scratch-desktop media library fetch failed." >&2
        exit 1
    fi

    npm run compile
    if [ "$?" != "0" ]; then
        echo "Error: scratch-desktop compile failed." >&2
        exit 1
    fi

    ./node_modules/.bin/electron-builder --win nsis --x64 --publish never
    if [ "$?" != "0" ]; then
        echo "Error: Windows Scratch Desktop build failed." >&2
        exit 1
    fi

    echo "Windows Scratch Desktop build completed successfully."
    exit 0
fi

scratch_editor_dir="$addon_dir/repos/scratch-editor"

if [ ! -f "$scratch_editor_dir/package.json" ]; then
    echo "Error: scratch-editor repository not found at $scratch_editor_dir" >&2
    exit 1
fi

if [ "$(command -v npm)" == "" ]; then
    echo "Error: npm is not available. Run 'jtScratch activate' first." >&2
    exit 1
fi

cd "$scratch_editor_dir"
if [ "$?" != "0" ]; then
    echo "Error: Could not access scratch-editor directory: $scratch_editor_dir" >&2
    exit 1
fi

npm run build
if [ "$?" != "0" ]; then
    echo "Error: scratch-editor build failed." >&2
    exit 1
fi

echo "scratch-editor build completed successfully."
